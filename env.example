# Supabase 配置
# 从 Supabase 项目设置中获取这些值：https://app.supabase.com/project/_/settings/api
# 复制此文件为 .env.local 并填入实际值(docker 部署复制成 .env)

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# 可选：通过当前站点的 Nginx 同源转发 Supabase，避免客户端拦截 Supabase 域名
NEXT_PUBLIC_SUPABASE_PROXY_PATH=

# web3forms 配置（可选）
# 从 web3forms 中获取这些值 https://app.web3forms.com/dashboard
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your_web3forms_access_key

# Google Analytics 配置（可选）
# 从 Google Analytics 中获取这些值 https://analytics.google.com/analytics/web/
NEXT_PUBLIC_GA_ID=G-xxxxxxxxxx

# GitHub Release 检查配置（可选）
# 若需要在页面中展示「发现新版本」更新提示，请配置为对应仓库的最新 Release 接口地址
# 例如本仓库默认值：
# https://api.github.com/repos/hzm0321/real-time-fund/releases/latest
NEXT_PUBLIC_GITHUB_LATEST_RELEASE_URL=

# GitHub 登录配置（可选）
# 控制是否开启 GitHub OAuth 登录功能
# 可选值: true / false (默认 false)
NEXT_PUBLIC_IS_GITHUB_LOGIN=false

# Sentry 配置（可选）
# 从 Sentry 项目设置中获取 DSN：https://sentry.io/settings/projects/
NEXT_PUBLIC_SENTRY_DSN=
# Sentry 身份验证令牌，用于构建时上传 Source Maps
SENTRY_AUTH_TOKEN=

# CS2 饰品看板数据服务
# 生产环境通过 `wrangler secret put STEAMDT_API_KEY` 保存，不要添加 NEXT_PUBLIC_ 前缀
# 本地开发时由 Node 服务从 .env.local 读取
STEAMDT_API_KEY=
# Cloudflare Worker 仅允许这个 SteamID64 使用 SteamDT 配额
CS2_ALLOWED_STEAM_ID=
# 默认留空：云端使用同域 /api/cs2，本地开发自动使用 31777 端口
NEXT_PUBLIC_CS2_PROXY_URL=
CS2_PROXY_PORT=31777
# 如需从其他本地站点访问，可使用英文逗号添加允许的来源
CS2_ALLOWED_ORIGINS=

# 如果要用 Github Actions 部署，需要在 Github 项目 Settings → secrets and actions → Actions → 创建 Repository secrets
